DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional private salt for anonymous lead rate-limit fingerprints. Never expose it with NEXT_PUBLIC_.
LEAD_HASH_SALT=
# Comma-separated allow-list. Only these verified Clerk accounts can access /dashboard and coach APIs.
COACH_EMAILS=coach@example.com
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# ---- Jonas Fitness Progress · Founding Access (server-only) ----
# Stripe-hosted Checkout. Secret keys must never be exposed with NEXT_PUBLIC_.
# STRIPE_SECRET_KEY must be a Stripe SECRET key: sk_test_... (test) or
# sk_live_... (production). Publishable pk_* keys are rejected. Production
# rejects sk_test_* and requires sk_live_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Must be a Stripe price id (price_...) for the €19 Founding Access one-time
# price. Server-controlled only; never accepted from the client.
STRIPE_PROGRESS_FOUNDING_PRICE_ID=
# "managed" = Stripe Managed Payments (merchant of record; indirect tax handled).
# "standard" = ordinary Stripe Payments (dev/fallback; company handles own tax).
# Production: must be set to one of these; missing/unknown fails clearly.
STRIPE_PAYMENT_MODE=standard
# Absolute public origin used for Checkout success/cancel URLs. Production
# requires a valid https URL; local dev may use http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Paywall gate. FAIL-CLOSED: production requires an explicit value (
# "true" to enable the commercial config; there is NO silent "off" default in
# production). Dev/test default OFF so existing accounts keep working.
PROGRESS_PAYWALL_ENABLED=false
# Internal testing bypass for allowed coaches (COACH_EMAILS) when paywall is on.
# Honored ONLY outside production; even if set to true in production it is
# ignored (fail-closed).
PROGRESS_DEV_TEST_BYPASS=false
